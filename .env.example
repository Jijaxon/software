# ===== Docker Compose + backend uchun yagona .env =====
# Serverda bu faylni ".env" nomi bilan nusxalang va qiymatlarni to'ldiring:
#   cp .env.example .env

# ---- PostgreSQL (docker ichida ishlaydi) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=STRONG_DB_PAROL_SHU_YERGA
POSTGRES_DB=cosmetic
# DATABASE_URL va PORT compose tomonidan avtomatik beriladi (o'zgartirish shart emas)

# ---- Auth ----
JWT_SECRET=uzun-va-tasodifiy-maxfiy-kalit

# ---- Frontend build (nisbiy "/api" tavsiya etiladi) ----
VITE_API_URL=/api

# ---- CORS / havolalar (production domen) ----
# Bir nechta origin vergul bilan: https://a.uz,https://b.uz
CORS_ORIGIN=https://cosmetic.saloxiddin.uz
CLIENT_URL=https://cosmetic.saloxiddin.uz

# ---- Telegram bot (@BotFather) ----
TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_BOT_USERNAME=

# ---- To'lov (narxlar so'mda) ----
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=uzs
UZS_PER_USD=12700
